DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
PGSSL=true
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
NEWS_API_KEY=your_newsapi_key_here
DEMAND_AI_PROVIDER=gemini
GEMINI_API_KEY=your_free_gemini_key_here
# Shared Gemini configuration used by existing AI features and Resume Parser
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional paid provider. Set DEMAND_AI_PROVIDER=openai to opt in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Student password-reset email OTP (configure with your mail provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_KEY=
